{
  "opencollection": "1.0.0",
  "info": {
    "name": "Idle Finance Pools TVL API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "TVL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get TVL per underlying token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.idle.finance/tvls",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns total value locked (TVL) per underlying token for all vaults on the target network."
        }
      ]
    }
  ],
  "bundled": true
}