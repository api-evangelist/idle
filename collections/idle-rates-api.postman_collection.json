  "info": {
    "_postman_id": "592f0975-b90d-4433-9570-2664bdd6877d",
    "name": "Idle Finance Pools Rates API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Idle Finance REST API provides programmatic access to Best Yield and Yield Tranches vault pools, total value locked (TVL) metrics, historical yield rates for underlying token addresses, and protocol-level data across supported networks (Ethereum, Polygon zkEVM, Optimism). Authentication is via Bearer token obtained by request.\n\nContact Support:\n Name: Idle Finance Developer Access",
      "type": "text/plain"
    }
  }
