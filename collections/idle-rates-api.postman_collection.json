      "item": [
        {
          "id": "841099e7-4a97-44db-9fa8-7598114740c5",
          "name": "Get historical rates for an underlying token",
          "request": {
            "name": "Get historical rates for an underlying token",
            "description": {
              "content": "Provides historical daily APY/rate data for Best Yield vaults filtered by the underlying token address and an optional calendar range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rates",
                ":address"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<long>",
                  "description": "Unix timestamp to filter results from (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<long>",
                  "description": "Unix timestamp to filter results to (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "isRisk",
                  "value": "<boolean>",
                  "description": "Filter by strategy risk type. true returns risk-adjusted strategy data, false returns the default Best Yield strategy data."
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "86400",
                  "description": "Number of seconds between data records. Defaults to 86400 (one day)."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "asc",
                  "description": "Sort order for results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of records to return."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "address",
                  "description": "(Required) Underlying token contract address (e.g. DAI, USDC, USDT, WETH on Ethereum)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
